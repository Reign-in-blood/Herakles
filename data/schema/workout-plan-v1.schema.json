{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Herakles reusable favorite or scheduled workout v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "kind",
    "name",
    "items",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "favorite",
        "scheduled"
      ]
    },
    "name": {
      "type": "string",
      "maxLength": 100
    },
    "source_session_id": {
      "type": "string"
    },
    "scheduled_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "uid",
          "exercise",
          "planned"
        ],
        "properties": {
          "uid": {
            "type": "string",
            "minLength": 1
          },
          "exercise": {
            "type": "object",
            "required": [
              "id",
              "name",
              "type"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "strength",
                  "cardio"
                ]
              },
              "resistance": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "primary_muscles": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": true
          },
          "planned": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  }
}
